# Local Development Environment
# This file is NOT tracked by git and contains configuration for local development

# Application Environment
APP_ENV=DEV

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Logging
LOG_LEVEL=DEBUG

# OpenAlex Data
# Host path where the OpenAlex snapshot is mounted
OPENALEX_DATA_HOST_PATH=/path/to/openalex/data

OPENALEX_DATA_PATH=/data/openalex

# API OpenSearch Configuration
OPENSEARCH_HOST=opensearch
OPENSEARCH_PORT=9200
OPENSEARCH_SCHEME=http

# OpenSearch Container Configuration
OPENSEARCH_CLUSTER_NAME=opensearch-cluster
OPENSEARCH_NODE_NAME=opensearch-node
OPENSEARCH_DISCOVERY_TYPE=single-node
OPENSEARCH_JAVA_OPTS=-Xms512m -Xmx512m
OPENSEARCH_INITIAL_ADMIN_PASSWORD=<change-me>
OPENSEARCH_SECURITY_DISABLED=true

EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_API_URL=https://rag-api.ilaas.fr/v1
EMBEDDING_API_KEY=<ilas-api-key>
EMBEDDING_API_MODEL=bge-m3
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_BATCH_SIZE=32

# ── Matching ──────────────────────────────────────────────────────────────────
# Number of taxonomy nodes processed per matrix-multiply chunk (memory guard).
CHUNK_SIZE=5000
# Maximum matches returned per taxonomy node (unset = no limit).
TOP_K=100

# Retry Configuration
RETRY_MAX_ATTEMPTS=3
RETRY_MIN_WAIT=2
RETRY_MAX_WAIT=10