[MASTER]
load-plugins=
jobs=1

[MESSAGES CONTROL]
disable=
    missing-docstring,
    too-few-public-methods,
    C0111,

[DESIGN]
max-args=7
max-attributes=10
max-bool-expr=5
max-branches=12
max-locals=15
max-parents=7
max-public-methods=20
max-returns=6
max-statements=50
min-public-methods=2

[VARIABLES]
dummy-variables-rgx=_+$|^dummy

[FORMAT]
max-line-length=100
indent-string='    '
